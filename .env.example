# PostgreSQL connection string. Required by migrations and seed scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenant_portal
NODE_ENV=production

# Stripe server-side Checkout and signed webhook configuration.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Reserved for future client-side Stripe features; this pass redirects to Checkout.
STRIPE_PUBLISHABLE_KEY=pk_test_...
PUBLIC_APP_URL=https://your-domain.example

# Email (Resend). If unset, notifications log to the server console.
# RESEND_API_KEY=
# NOTIFY_FROM_EMAIL=Portal <noreply@yourdomain.com>

# SMS (Twilio). If unset, texts log to the server console.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
